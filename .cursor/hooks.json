{
  "version": 1,
  "hooks": {
    "sessionStart": [{ "command": ".cursor/hooks/audit.sh" }],
    "sessionEnd": [{ "command": ".cursor/hooks/audit.sh" }],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/protect-demo-reset.py",
        "failClosed": true
      },
      {
        "command": ".cursor/hooks/guard.sh",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "python3 .cursor/hooks/protect-demo-reset.py",
        "matcher": "Delete",
        "failClosed": true
      }
    ],
    "afterFileEdit": [{ "command": ".cursor/hooks/audit.sh" }],
    "stop": [{ "command": ".cursor/hooks/audit.sh" }]
  }
}
